-- Универсальный скрипт для всех двухполюсных радиодеталей
-- Цветовая маркировка резисторов по стандарту IEC 60062
local color_code = require("src.color_code")
-- Центральный модуль меш-проводов и топологии
local wire = require("src.wire")

-- Свойства компонента в редакторе Defold
go.property("comp_type", hash("resistor")) -- Тип детали: резистор или источник тока
go.property("value", 20.0)                 -- Номинал: Омы для резистора, Амперы для источника тока
go.property("rotation_step", 15)           -- Шаг поворота колесиком мыши в градусах
go.property("scale", 1.0)                  -- Собственный масштаб детали

local BASE_PIN_RADIUS = 25.0

-- Проверка наличия дочерних спрайтов цветовых полосок
local function has_band_components()
	local ok, _ = pcall(go.get, "#band_1", "tint")
	return ok
end

-- Вычисление мировых координат левого и правого пинов и векторов их направлений
local function get_pin_positions(self)
	local pos = go.get_world_position()
	local size = go.get("#sprite", "size")
	local scale = go.get_world_scale()
	local half_w = (size.x * scale.x) * 0.5

	local rad = math.rad(self.angle_deg)
	local cos_a = math.cos(rad)
	local sin_a = math.sin(rad)

	-- Направления наружу от торцов детали
	local dir1 = vmath.vector3(-cos_a, -sin_a, 0)
	local dir2 = vmath.vector3(cos_a, sin_a, 0)

	local p1 = pos + dir1 * half_w
	local p2 = pos + dir2 * half_w

	return p1, p2, dir1, dir2
end

-- Проверка попадания курсора мыши в зону пина
local function get_hovered_pin(self, mouse_world_x, mouse_world_y)
	local scale = go.get_world_scale()
	local p1, p2 = get_pin_positions(self)
	local hit_radius = math.max(15.0, BASE_PIN_RADIUS * scale.x)
	local mouse_pos = vmath.vector3(mouse_world_x, mouse_world_y, 0)

	if vmath.length(vmath.vector3(p1.x, p1.y, 0) - mouse_pos) <= hit_radius then
		return 1
	elseif vmath.length(vmath.vector3(p2.x, p2.y, 0) - mouse_pos) <= hit_radius then
		return 2
	end
	return nil
end

-- Проверка попадания курсора мыши в повернутый прямоугольник корпуса детали
local function is_cursor_over(self, mouse_world_x, mouse_world_y)
	local pos = go.get_world_position()
	local size = go.get("#sprite", "size")
	local scale = go.get_world_scale()
	local half_w = (size.x * scale.x) * 0.5
	local half_h = (size.y * scale.y) * 0.5

	local dx = mouse_world_x - pos.x
	local dy = mouse_world_y - pos.y

	local rad = math.rad(-self.angle_deg)
	local cos_a = math.cos(rad)
	local sin_a = math.sin(rad)

	local local_x = dx * cos_a - dy * sin_a
	local local_y = dx * sin_a + dy * cos_a

	return math.abs(local_x) <= half_w and math.abs(local_y) <= half_h
end

-- Обновление цветов полосок на резисторе по его сопротивлению
local function update_band_colors(self)
	if self.comp_type ~= hash("resistor") or not self.has_bands then return end
	local bands = color_code.ohms_to_bands(self.value)
	for i = 1, 5 do
		go.set(string.format("#band_%d", i), "tint", bands[i].color)
	end
end

-- Переключение анимации спрайта в зависимости от типа детали, вида и темы
local function update_visual(self)
	local type_str = "resistor"
	if self.comp_type == hash("direct_current_source") or self.comp_type == hash("battery") or self.comp_type == hash("dc_source") or self.comp_type == hash("current_source") then
		type_str = "direct_current_source"
	end

	sprite.play_flipbook("#sprite", hash(string.format("%s_%s_%s", type_str, self.view_mode, self.theme_mode)))

	if self.has_bands then
		local hide_bands = (self.view_mode == "gost" or self.comp_type ~= hash("resistor"))
		for i = 1, 5 do
			msg.post(string.format("#band_%d", i), hide_bands and "disable" or "enable")
		end
	end
end

-- Отрисовка первичной отладочной информации на корпусе детали и над ее пинами
local function draw_component_debug_info(self, my_id, p1, p2)
	local pos = go.get_world_position()
	local is_res = (self.comp_type == hash("resistor"))

	-- Первая строка: тип детали и ее номинал
	local header_str
	if is_res then
		header_str = string.format("RES [R=%.1f Ohm]", self.value)
	else
		header_str = string.format("SRC [I=%.1f A]", self.value)
	end

	-- Вторая строка: рассчитанные напряжение, ток и мощность из решателя
	local branch = wire.circuit_results.branches[my_id]
	local state_str
	if branch then
		state_str = string.format("U=%.2fV | I=%.2fA | P=%.2fW", branch.voltage, branch.current, branch.power)
	else
		state_str = "U=0.00V | I=0.00A [OPEN]"
	end

	msg.post("@render:", "draw_text", {
		text = header_str,
		position = wire.world_to_screen(pos.x - 55, pos.y + 52)
	})
	msg.post("@render:", "draw_text", {
		text = state_str,
		position = wire.world_to_screen(pos.x - 75, pos.y + 36)
	})

	-- Подписи узлов прямо возле первого и второго пина детали
	local n1 = wire.get_pin_node(my_id, 1)
	local n2 = wire.get_pin_node(my_id, 2)
	local p1_label = n1 ~= nil and string.format("P1:N%d", n1) or "P1:-"
	local p2_label = n2 ~= nil and string.format("P2:N%d", n2) or "P2:-"

	msg.post("@render:", "draw_text", {
		text = p1_label,
		position = wire.world_to_screen(p1.x - 18, p1.y + 22)
	})
	msg.post("@render:", "draw_text", {
		text = p2_label,
		position = wire.world_to_screen(p2.x - 18, p2.y + 22)
	})
end

function init(self)
	msg.post(".", "acquire_input_focus")
	msg.post("@render:", "use_fixed_projection", { near = -1, far = 1, zoom = 1 })

	self.is_dragging = false
	self.ctrl_pressed = false
	self.drag_offset = vmath.vector3(0, 0, 0)
	self.angle_deg = 0
	self.wiring_pin = nil
	self.wire_mouse_pos = vmath.vector3(0, 0, 0)

	self.view_mode = "real"
	self.theme_mode = "dark"
	self.has_bands = has_band_components()

	local pos = go.get_position()
	go.set_position(vmath.vector3(pos.x, pos.y, 0))
	go.set_scale(vmath.vector3(self.scale, self.scale, 1))

	-- Регистрируем электрические параметры детали в реестре топологии
	wire.register_component_data(go.get_id(), self.comp_type, self.value)

	update_visual(self)
	update_band_colors(self)
end

function on_message(self, message_id, message, sender)
	if message_id == hash("set_view_mode") then
		self.view_mode = message.view_mode
	elseif message_id == hash("set_theme_mode") then
		self.theme_mode = message.theme_mode
	elseif message_id == hash("set_resistance") or message_id == hash("set_value") then
		self.value = message.value or message.resistance or self.value
		update_band_colors(self)
		-- Обновляем номинал в системе топологии и сразу пересчитываем схему
		wire.register_component_data(go.get_id(), self.comp_type, self.value)
		wire.recalculate_circuit()
	end
	update_visual(self)
end

function update(self, dt)
	local scale = go.get_world_scale()
	local p1, p2, dir1, dir2 = get_pin_positions(self)
	local my_id = go.get_id()

	wire.register_pins(my_id, p1, dir1, p2, dir2, scale.x, self.comp_type, self.value)

	-- Выводим отладочную информацию над деталью и ее контактами
	draw_component_debug_info(self, my_id, p1, p2)

	if self.view_mode ~= "real" then
		wire.clear_preview(my_id)
		return
	end

	local theme = wire.THEME_COLORS[self.theme_mode] or wire.THEME_COLORS.dark
	local r = 20 * scale.x
	local pin1_top = vmath.vector3(p1.x, p1.y, 0.2)
	local pin2_top = vmath.vector3(p2.x, p2.y, 0.2)

	-- Отладочные крестики на пинах
	msg.post("@render:", "draw_line", { start_point = pin1_top + vmath.vector3(-r, -r, 0), end_point = pin1_top + vmath.vector3(r, r, 0), color = vmath.vector4(1, 0, 0, 1) })
	msg.post("@render:", "draw_line", { start_point = pin1_top + vmath.vector3(-r, r, 0), end_point = pin1_top + vmath.vector3(r, -r, 0), color = vmath.vector4(1, 0, 0, 1) })
	msg.post("@render:", "draw_line", { start_point = pin2_top + vmath.vector3(-r, -r, 0), end_point = pin2_top + vmath.vector3(r, r, 0), color = vmath.vector4(0, 0, 1, 1) })
	msg.post("@render:", "draw_line", { start_point = pin2_top + vmath.vector3(-r, r, 0), end_point = pin2_top + vmath.vector3(r, -r, 0), color = vmath.vector4(0, 0, 1, 1) })

	if self.wiring_pin then
		local start_pos = (self.wiring_pin == 1) and p1 or p2
		local start_dir = (self.wiring_pin == 1) and dir1 or dir2
		local hit_r = math.max(15.0, BASE_PIN_RADIUS * scale.x)
		local target_id, target_pin = wire.find_closest_pin(self.wire_mouse_pos.x, self.wire_mouse_pos.y, hit_r, my_id, self.wiring_pin)

		local end_pos = self.wire_mouse_pos
		local end_dir = nil
		if target_id and wire.pins[target_id] then
			end_pos = wire.pins[target_id][target_pin].pos
			end_dir = wire.pins[target_id][target_pin].dir
		end

		wire.set_preview(my_id, start_pos, start_dir, end_pos, end_dir, theme.preview, scale.x)
	else
		wire.clear_preview(my_id)
	end

	wire.render_all(theme.wire, my_id)
end

function on_input(self, action_id, action)
	-- Отслеживаем нажатие клавиши Ctrl чтобы не крутить деталь во время зума стола
	if action_id == hash("key_ctrl") then
		if action.pressed then
			self.ctrl_pressed = true
		elseif action.released then
			self.ctrl_pressed = false
		end
	end

	local proj_w = sys.get_config_int("display.width", 960)
	local proj_h = sys.get_config_int("display.height", 640)
	local win_w, win_h = window.get_size()
	local offset_x = -(win_w - proj_w) * 0.5
	local offset_y = -(win_h - proj_h) * 0.5
	local screen_x = ((action.x or 0) / proj_w) * win_w
	local screen_y = ((action.y or 0) / proj_h) * win_h

	local mouse_world_x = screen_x + offset_x
	local mouse_world_y = screen_y + offset_y
	local mouse_world = vmath.vector3(mouse_world_x, mouse_world_y, 0)

	-- Перевод мировых координат мыши в локальные координаты контейнера стола
	local board_pos = go.get_position(hash("/board"))
	local board_scale = go.get_scale(hash("/board")).x
	local mouse_local_x = (mouse_world_x - board_pos.x) / board_scale
	local mouse_local_y = (mouse_world_y - board_pos.y) / board_scale
	local mouse_local = vmath.vector3(mouse_local_x, mouse_local_y, 0)

	self.wire_mouse_pos = mouse_world

	local pin_index = get_hovered_pin(self, mouse_world.x, mouse_world.y)
	local hovered = is_cursor_over(self, mouse_world.x, mouse_world.y)

	-- Правая кнопка мыши по пину удаляет подключенный к этому краю детали провод
	if action_id == hash("right_click") and action.pressed then
		if self.wiring_pin then
			self.wiring_pin = nil
			wire.clear_preview(go.get_id())
			return true
		elseif pin_index and self.view_mode == "real" then
			wire.disconnect_pin(go.get_id(), pin_index)
			return true
		end
	end

	if action_id == hash("click") then
		if action.pressed then
			if pin_index and self.view_mode == "real" then
				self.wiring_pin = pin_index
			elseif hovered then
				self.is_dragging = true
				local pos = go.get_position()
				self.drag_offset = vmath.vector3(pos.x - mouse_local.x, pos.y - mouse_local.y, 0)
				go.set_position(vmath.vector3(pos.x, pos.y, 0.1))
			end
		elseif action.released then
			if self.wiring_pin then
				local hit_r = math.max(15.0, BASE_PIN_RADIUS * go.get_world_scale().x)
				local target_id, target_pin = wire.find_closest_pin(mouse_world.x, mouse_world.y, hit_r, go.get_id(), self.wiring_pin)
				if target_id then
					wire.connect(go.get_id(), self.wiring_pin, target_id, target_pin)
				end
				self.wiring_pin = nil
				wire.clear_preview(go.get_id())
			end
			if self.is_dragging then
				self.is_dragging = false
				local pos = go.get_position()
				go.set_position(vmath.vector3(pos.x, pos.y, 0))
			end
		end
	end

	if self.is_dragging and action.x and action.y then
		go.set_position(vmath.vector3(mouse_local.x + self.drag_offset.x, mouse_local.y + self.drag_offset.y, 0.1))
	end

	-- Вращение детали колесиком мыши при перетаскивании если не зажат Ctrl
	if self.is_dragging and not self.ctrl_pressed then
		if action_id == hash("wheel_up") and action.pressed then
			self.angle_deg = (self.angle_deg + self.rotation_step) % 360
			go.set_rotation(vmath.quat_rotation_z(math.rad(self.angle_deg)))
		elseif action_id == hash("wheel_down") and action.pressed then
			self.angle_deg = (self.angle_deg - self.rotation_step) % 360
			go.set_rotation(vmath.quat_rotation_z(math.rad(self.angle_deg)))
		end
	end
end